<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.rustore.sdk.pushclient" >

    <uses-sdk android:minSdkVersion="23" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="ru.vk.store" />

        <intent>
            <action android:name="com.vk.push.HOST_SERVICE" />
        </intent>
        <intent>
            <action android:name="com.vk.push.GET_DEVICE_ID" />
        </intent>
    </queries>

    <application>
        <provider
            android:name="ru.rustore.sdk.pushclient.provider.RuStorePushClientInitProvider"
            android:authorities="${applicationId}.rustorepushclientinitprovider"
            android:directBootAware="true"
            android:exported="false"
            android:initOrder="100"
            tools:targetApi="n" />

        <receiver
            android:name="ru.rustore.sdk.pushclient.internal.arbiter.ArbiterBroadcastReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="com.vk.push.ACTION_MASTER_HOST_UPDATE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>